# Doxyfile for DiskUtilities (Doxygen 1.9.x). Run from the repository root: doxygen docs/Doxyfile
PROJECT_NAME           = "DiskUtilities"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Read-only disk usage analysis and file search with a C++23 core and a WebUI front end"
